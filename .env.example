# Cloud credentials for `npm run seal`.
#
# Copy to .env and fill in. They are encrypted into public/ideas.sealed.json
# together with the idea list, so the access code unlocks both and judges
# connect to the shared dashboard without pasting anything.
#
# .env is gitignored and must stay that way: the anon key grants read/write
# to the database, where the ideas are stored in plain text.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
