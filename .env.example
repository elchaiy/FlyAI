# Cloud credentials for `npm run seal`.
#
# COPY this file to .env (do not rename it — a rename leaves no example behind,
# and on Windows "New Text Document" adds a .txt suffix that .gitignore does
# not cover, which is how a key once reached the public repo).
#
# The values are encrypted into public/ideas.sealed.json together with the idea
# list, so the access code unlocks both and judges connect to the shared
# dashboard without pasting anything.
#
# .env is gitignored and must stay that way: the key grants read/write to the
# database, where the ideas are stored in plain text.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
